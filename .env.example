## REPROX backend configuration (copy to .env and edit)

# PostgreSQL connection used by the backend
POSTGRES_USER=reprox
POSTGRES_PASSWORD=reprox_dev_password
POSTGRES_DB=reprox
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://reprox:reprox_dev_password@localhost:5432/reprox

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Execution sandbox
SANDBOX_IMAGE=reprox-sklearn-runner:latest
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1

# AI provider (left unset in MVP - AIProvider resolves to NullProvider)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
